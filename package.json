{
  "name": "designstudio-pro",
  "private": true,
  "version": "0.1.0",
  "description": "DesignStudio Pro — estúdio de design tudo-em-um no navegador",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "site": "vite build --config vite.config.site.ts && node scripts/baixar-fontes.mjs dist-site/fontes.css && node scripts/gerar-site.mjs",
    "landing": "node scripts/gerar-landing.mjs"
  },
  "dependencies": {
    "konva": "^9.3.14",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.0.3"
  }
}
